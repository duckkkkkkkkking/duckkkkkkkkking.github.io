{
	# Global options
	admin off
}

# Personal website
yuxuanhu.cn {
	root * /var/www/yuxuanhu
	file_server

	# Reverse proxy CLIProxyAPI under the /ai subpath
	handle_path /ai/* {
		reverse_proxy 127.0.0.1:8888 {
			flush_interval -1
		}
	}

	encode zstd gzip
}

# Overleaf reverse proxy (internal network via ZeroTier)
overleaf.yuxuanhu.cn {
	reverse_proxy 192.168.194.171:80
}
